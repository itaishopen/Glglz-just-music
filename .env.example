# ── Spotify credentials (required) ───────────────────────────────────────────
# Create a Spotify Developer app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Run:  node scripts/get-token.js   to generate this
SPOTIFY_REFRESH_TOKEN=your_refresh_token_here

# The Spotify playlist to add songs to.
# The playlist ID is the string after /playlist/ in the Spotify share URL.
# e.g. https://open.spotify.com/playlist/37i9dQZF1DXcBWIGoYBM5M → 37i9dQZF1DXcBWIGoYBM5M
SPOTIFY_PLAYLIST_ID=your_playlist_id_here

# ── Optional settings ─────────────────────────────────────────────────────────
# Galgalatz page URL (default is already correct)
# GLGLZ_URL=https://glz.co.il/%D7%92%D7%9C%D7%92%D7%9C%D7%A6

# Path to system Chromium.
# Required on Raspberry Pi 3 (ARM32) — the bundled Playwright Chromium is ARM64 only.
# On Pi 3: CHROMIUM_PATH=/usr/bin/chromium-browser
# CHROMIUM_PATH=

# How often to check the site (milliseconds). Default: 3 minutes = 180000
# CHECK_INTERVAL_MS=180000

# Maximum number of songs to keep in the playlist (oldest removed first)
# MAX_PLAYLIST_SIZE=100

# Timeout waiting for the page to load (milliseconds)
# SCRAPER_TIMEOUT_MS=45000

# Log level: error | warn | info | debug
# LOG_LEVEL=info

# Set to "true" to write logs to files in the logs/ directory (in addition to console)
# Not recommended on SD-card-based Pi deployments due to write wear.
# LOG_TO_FILE=false

# Path to the local state file (records the last-played song)
# STATE_FILE=./data/state.json
